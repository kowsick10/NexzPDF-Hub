# nexPDF tool – Environment Configuration
# Copy this file to .env and update values before production deployment

# Token secret – generate a random 32+ character string for production
NEXPDF_TOKEN_SECRET=

# Public HTTP port used by Docker (reverse-proxy panels can route a domain to this port)
NEXPDF_HTTP_PORT=8080

# CORS – comma-separated origins
# Same-origin deployment: add https://your-domain.example and http://127.0.0.1:8080
NEXPDF_ALLOWED_ORIGINS=https://your-domain.example,http://localhost:8080,http://127.0.0.1:8080

# File limits
NEXPDF_MAX_FILE_SIZE_MB=25
NEXPDF_MAX_UPLOAD_FILES=10
NEXPDF_MAX_COMBINED_SIZE_MB=100
NEXPDF_MAX_PDF_PAGES=200
NEXPDF_FILE_RETENTION_MINUTES=60
NEXPDF_MAX_PROCESSING_SECONDS=120
NEXPDF_MAX_CONCURRENT_JOBS=2

# Storage paths (use Docker volumes in production)
NEXPDF_UPLOAD_DIR=/tmp/nexpdf/uploads
NEXPDF_JOBS_DIR=/tmp/nexpdf/jobs

# Debug (never true in production)
NEXPDF_DEBUG=false
